# make client / deploy.sh 的本地部署配置示例。
# 复制为 .env 后填写实际值；.env 已被 Git 忽略，勿提交密码等敏感信息。
# 小爱音箱的ip地址
SPEAKER_HOST=192.168.1.100
# migpt部署后的地址
SERVER_URL=wss://mi.example.com
# 小爱音箱ssh配置，密码设置是在打包修改固件时设置在 packages/client-patch/.env中的
SSH_USER=root
SSH_PORT=22
SSH_PASSWORD=

TARGET=armv7-unknown-linux-gnueabihf
BUILD=1
REBOOT=1
